---
// Startseite für Eltern: Himmel mit schwebender Insel und „Spiel starten“, darunter auf Erde die Abschnitte
// (was es ist, zusammen spielen, wächst mit, Bildschirmzeit, Versprechen). Ohne JavaScript vollständig lesbar.
// Alle Texte stehen in src/data/landing.ts, die Eckdaten in src/content/games/mitwachsen.md, die strukturierten Daten
// für Suchmaschinen in src/data/site.ts.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Clouds from '../components/Clouds.astro';
import VoxelIcon from '../components/VoxelIcon.astro';
import { ISLAND, sceneSvg, tower } from '../lib/voxel/blocks';
import { CUBE_W } from '../lib/voxel/cube';
import { homeLd } from '../data/site';
import { ABOUT, CLOSING, HERO, PLAY_URL, PROMISES, SCREEN_TIME, STAGES, TOGETHER } from '../data/landing';
import shot from '../assets/games/mitwachsen.webp';
import '../styles/landing.css';

const g = await getEntry('games', 'mitwachsen');
if (!g) throw new Error('Inhalt src/content/games/mitwachsen.md fehlt');
const facts: [string, string][] = [
  ['Alter', g.data.age],
  ['Gespielt', g.data.together],
  ['Steuerung', g.data.controls],
  ['Läuft', g.data.device],
  ...ABOUT.facts,
];

const island = sceneSvg(ISLAND);
// Säulen der Altersstufen: gleiche Blockbreite, jede Stufe einen Block höher
const TOWER_W = 56;
const towers = STAGES.list.map((s, n) => {
  const t = sceneSvg(tower(n + 1));
  const h = Number(t.viewBox.split(' ')[3]);
  return { ...s, ...t, height: Math.round((h * TOWER_W) / CUBE_W) };
});
const maxTower = Math.max(...towers.map((t) => t.height));
---

<BaseLayout description={g.data.teaser}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(homeLd(g.data.teaser)).replaceAll('<', '\\u003c')}
  />
  <header class="sky landing-sky">
    <Clouds />
    <SiteHeader />
    <div class="hero">
      <div class="hero-text">
        <h1 class="hero-title">{HERO.title}</h1>
        <p class="subtitle">{HERO.subtitle}</p>
        <p class="intro">{HERO.intro}</p>
        <div class="cta">
          <a class="pxbtn" href={PLAY_URL}>
            {HERO.cta}
          </a>
          <a class="more" href="#eltern">
            {HERO.more}
          </a>
        </div>
      </div>
      <svg class="hero-scene" viewBox={island.viewBox} aria-hidden="true" set:html={island.uses} />
    </div>
  </header>
  <div class="grass-edge" aria-hidden="true"></div>

  <main id="inhalt" tabindex="-1" class="ground landing">
    <section id="eltern" class="panel pxbox" aria-labelledby="t-about">
      <div class="panel-head">
        <VoxelIcon block="grass" size={56} />
        <h2 id="t-about">{ABOUT.title}</h2>
      </div>
      <div class="about">
        <div class="prose">
          {ABOUT.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <dl class="facts">
          {facts.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class="shot">
        <Image src={shot} alt={ABOUT.shotAlt} widths={[480, 800, 1100]} sizes="(max-width: 1180px) 100vw, 1100px" />
        <figcaption>{ABOUT.shotCaption}</figcaption>
      </figure>
    </section>

    <section class="panel pxbox" aria-labelledby="t-together">
      <div class="panel-head">
        <VoxelIcon block="plank" size={56} />
        <h2 id="t-together">{TOGETHER.title}</h2>
      </div>
      <ol class="steps">
        {TOGETHER.steps.map((s) => (
          <li class="step pxsm">
            <VoxelIcon block={s.block} size={48} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="panel pxbox" aria-labelledby="t-stages">
      <div class="panel-head">
        <VoxelIcon block="leaves" size={56} />
        <h2 id="t-stages">{STAGES.title}</h2>
      </div>
      <p class="lead">{STAGES.intro}</p>
      <ol class="stages">
        {towers.map((t) => (
          <li class:list={['stage', { now: t.status === 'spielbar' }]}>
            <div class="tower-box" style={`height: ${maxTower}px`}>
              <svg
                class="tower"
                width={TOWER_W}
                height={t.height}
                viewBox={t.viewBox}
                aria-hidden="true"
                set:html={t.uses}
              />
            </div>
            <h3>{t.age}</h3>
            <p class="status pxsm">{t.status}</p>
            <p>{t.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="panel pxbox" aria-labelledby="t-time">
      <div class="panel-head">
        <VoxelIcon block="log" size={56} />
        <h2 id="t-time">{SCREEN_TIME.title}</h2>
      </div>
      <p class="lead">{SCREEN_TIME.intro}</p>
      <dl class="marks">
        {SCREEN_TIME.marks.map((m) => (
          <div class="pxsm">
            <dt>{m.time}</dt>
            <dd>{m.text}</dd>
          </div>
        ))}
      </dl>
      <p class="lead">{SCREEN_TIME.note}</p>
    </section>

    <section class="panel pxbox" aria-labelledby="t-promises">
      <div class="panel-head">
        <VoxelIcon block="stone" size={56} />
        <h2 id="t-promises">{PROMISES.title}</h2>
      </div>
      <ul class="promises">
        {PROMISES.items.map((item) => (
          <li>
            <svg width="20" height="20" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
              <path d="M1 4h1v1h-1z M2 5h1v1h-1z M3 6h1v1h-1z M4 5h1v1h-1z M5 4h1v1h-1z M6 3h1v1h-1z M7 2h1v1h-1z" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section class="panel pxbox closing th-spiel" aria-labelledby="t-closing">
      <VoxelIcon block="pilz" size={72} />
      <div>
        <h2 id="t-closing">{CLOSING.title}</h2>
        <p>{CLOSING.text}</p>
      </div>
      <a class="pxbtn" href={PLAY_URL}>
        {HERO.cta}
      </a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
