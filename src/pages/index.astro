---
// Startseite: die Spielauswahl. Himmel mit schwebender Insel, darunter auf Erde je Spiel eine Karte (ein Link auf die
// Detailseite), ein Hinweis auf weitere Spiele und „Für Eltern“ mit den Versprechen für alle Spiele (Anker #eltern,
// der alte Sprung der Startseite). Gestartet wird erst auf der Detailseite. Ohne JavaScript vollständig.
// Texte in src/data/home.ts, Karten aus src/content/games/, strukturierte Daten aus src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Clouds from '../components/Clouds.astro';
import VoxelIcon from '../components/VoxelIcon.astro';
import GameCard from '../components/GameCard.astro';
import Promises from '../components/Promises.astro';
import { ISLAND, sceneSvg } from '../lib/voxel/blocks';
import { homeLd, ldJson } from '../data/site';
import { HOME, PARENTS } from '../data/home';
import { loadGames } from '../data/games';
import '../styles/home.css';

const games = await loadGames();
const island = sceneSvg(ISLAND);
const ld = homeLd(games.map((g) => ({ slug: g.id, name: g.data.title })));
---

<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={ldJson(ld)} />
  <header class="sky home-sky">
    <Clouds />
    <SiteHeader />
    <div class="hero">
      <div class="hero-text">
        <h1 class="hero-title">{HOME.title}</h1>
        <p class="subtitle">{HOME.subtitle}</p>
        <p class="intro">{HOME.intro}</p>
        <p class="cta">
          <a class="more" href="#eltern">
            {HOME.more}
          </a>
        </p>
      </div>
      <svg class="hero-scene" viewBox={island.viewBox} aria-hidden="true" set:html={island.uses} />
    </div>
  </header>
  <div class="grass-edge" aria-hidden="true"></div>

  <main id="inhalt" tabindex="-1" class="ground home">
    <section class="games" aria-labelledby="t-games">
      <h2 id="t-games" class="sign">
        {HOME.pick}
      </h2>
      <ul class:list={['game-list', { single: games.length === 1 }]}>
        {games.map((g) => (
          <GameCard game={g} />
        ))}
      </ul>
      <p class="seed">
        <VoxelIcon block="leaves" size={32} />
        {HOME.seed}
      </p>
    </section>

    <section id="eltern" class="panel pxbox parents" aria-labelledby="t-parents">
      <div class="panel-head">
        <VoxelIcon block="stone" size={56} />
        <h2 id="t-parents">{PARENTS.title}</h2>
      </div>
      <p class="lead">{PARENTS.text}</p>
      <Promises />
      <p class="parents-more">
        <a href="/weltenbummler/#eltern">{PARENTS.more}</a>
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
