---
// Kopf der einfachen Seiten: Himmel, Logo, Rückweg „Alle Spiele“ und Titel.
import SiteHeader from './SiteHeader.astro';
import Clouds from './Clouds.astro';
import BackButton from './BackButton.astro';

interface Props {
  title: string;
  lead?: string;
  back?: boolean; // Rückweg zur Spielauswahl auf der Startseite
}
const { title, lead, back = true } = Astro.props;
---

<header class="sky subhero">
  <Clouds />
  <SiteHeader />
  <div class="subhero-row">
    <div class="subhero-text">
      {back && <BackButton />}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </div>
</header>
