---
// Stand eines Spiels als Marken: spielbar mit Pixel-Haken, „kommt bald“ gestrichelt. Nie nur Farbe: der Text sagt es.
interface Props {
  status: { text: string; done: boolean }[];
}
const { status } = Astro.props;
---

<span class="pills">
  {status.map((s) => (
    <span class:list={['pill', { soon: !s.done }]}>
      {s.done && (
        <svg width="12" height="12" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
          <path d="M1 4h1v1h-1z M2 5h1v1h-1z M3 6h1v1h-1z M4 5h1v1h-1z M5 4h1v1h-1z M6 3h1v1h-1z M7 2h1v1h-1z" />
        </svg>
      )}
      {s.text}
    </span>
  ))}
</span>
